{
  "name": "rare-arcade",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:fx": "vitest run src/components/machine/__tests__/renderPullfxScenes.test.ts src/components/machine/__tests__/renderPrizePanelScenes.test.ts src/components/machine/__tests__/renderRfTokenScenes.test.ts src/pages/__tests__/renderWonPrizeScenes.test.ts src/pages/__tests__/renderArcadeFloorScenes.test.ts && playwright test --config=playwright.pullfx.config.ts",
    "check:live": "node scripts/live-check.mjs"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.1",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "happy-dom": "^17.1.8",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  }
}
