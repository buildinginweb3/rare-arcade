# RARE ARCADE — server-side environment (NEVER commit real values).
# These variables belong on the SERVER ONLY (Vercel project settings,
# local shell exports for `npm run dev`). They must NEVER be VITE_-prefixed
# and must NEVER appear in the browser bundle, HTML, or localStorage.

# OpenSea API v2 key used ONLY by /api/rare-friends (server proxy).
# Get one at https://opensea.io/settings/developer
# (or POST https://api.opensea.io/api/v2/auth/keys for a short-lived key).
OPENSEA_API_KEY=

# Read-only Robinhood Chain RPC for ownerOf verification (no transactions).
# Default in code: https://rpc.mainnet.chain.robinhood.com
ROBINHOOD_RPC_URL=
